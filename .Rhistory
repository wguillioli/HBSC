# 1. Your current working UN Sub-regions
sub_region2 = countrycode(
sourcevar = country,
origin = "country.name",
destination = "un.regionsub.name",
custom_match = c(
"England"  = "Northern Europe",
"Scotland" = "Northern Europe",
"Wales"    = "Northern Europe"
)
),
# 2. ADDED: European Union Status (Returns "EU" or NA)
eu_status = countrycode(
sourcevar = country,
origin = "country.name",
destination = "eu28",
# Handles UK nations (historic EU28 status) and Belgium variants
custom_match = c(
"England"           = "EU",
"Scotland"          = "EU",
"Wales"             = "EU",
"Belgium (Flemish)" = "EU",
"Belgium (French)"  = "EU"
)
),
# 3. ADDED: World Bank Regions (Groups Europe and Central Asia together)
wb_region = countrycode(
sourcevar = country,
origin = "country.name",
destination = "region",
# Maps your custom text variants to the World Bank designation
custom_match = c(
"England"           = "Europe & Central Asia",
"Scotland"          = "Europe & Central Asia",
"Wales"             = "Europe & Central Asia",
"Belgium (Flemish)" = "Europe & Central Asia",
"Belgium (French)"  = "Europe & Central Asia"
)
)
)
