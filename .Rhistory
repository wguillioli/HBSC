pf_log_odds <- function(m, X) {
prob <- predict(m, X, type = "prob")$.pred_Yes
prob <- pmax(pmin(prob, 1 - 1e-15), 1e-15)
log_odds <- log(prob / (1 - prob))
return(log_odds)
}
