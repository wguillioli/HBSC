set.seed(42)
n_samples <- 100
# 1. Create standard binary features (Rows = Samples, Columns = Features)
features_df <- data.frame(
FeatureA = sample(c(0, 1), n_samples, replace = TRUE),
FeatureB = sample(c(0, 1), n_samples, replace = TRUE),
FeatureC = sample(c(0, 1), n_samples, replace = TRUE)
)
# Create binary labels
labels <- sample(c(0, 1), n_samples, replace = TRUE)
# 2. Reformat to CORELS native structure
# Each line must start with a rule name (e.g., "{FeatureA}") followed by the vector of values
out_lines <- sapply(names(features_df), function(col_name) {
rule_name <- paste0("{", col_name, "}")
bit_vector <- paste(features_df[[col_name]], collapse = " ")
return(paste(rule_name, bit_vector))
})
# 3. Write out files using standard text connections
rules_file <- tempfile(fileext = ".out")
labels_file <- tempfile(fileext = ".label")
writeLines(out_lines, con = rules_file)
writeLines(paste(labels, collapse = " "), con = labels_file)
# 4. Execute CORELS
output_rules <- corels(
rules_file = rules_file,
labels_file = labels_file,
log_dir = tempdir(),
meta_file = "",
regularization = 0.01,
verbosity_policy = "rule",
run_curiosity = TRUE,
curiosity_policy = 2L
)
features_df
labels
write_csv(features_df, "features_df.csv")
write_csv(labels, "labels.csv")
write_csv(labels, "labels.csv")
# Create binary labels
labels <- data.frame(sample(c(0, 1), n_samples, replace = TRUE))
write_csv(labels, "labels.csv")
library(corels)
logdir <- tempdir()
rules_file <- system.file("sample_data", "compas_train.out", package="corels")
labels_file <- system.file("sample_data", "compas_train.label", package="corels")
meta_file <- system.file("sample_data", "compas_train.minor", package="corels")
stopifnot(file.exists(rules_file),
file.exists(labels_file),
file.exists(meta_file),
dir.exists(logdir))
corels(rules_file, labels_file, logdir, meta_file,
verbosity_policy = "silent",
regularization = 0.015,
curiosity_policy = 2,   # by lower bound
map_type = 1) 	   # permutation map
cat("See ", logdir, " for result file.")
