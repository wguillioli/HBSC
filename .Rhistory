View(dat)
# plot a cool diverging bar chart for paper
# 1. Reshape, remove 4s entirely, and recalculate percentages based on the active sample
final_plot_data <- dat %>%
select(famhelp, famsup, famtalk, famdec) %>%
pivot_longer(cols = everything(), names_to = "Question", values_to = "Response") %>%
filter(!is.na(Response) & Response != 4) %>% # <-- Removes missing values AND the neutral 4s
count(Question, Response) %>%
group_by(Question) %>%
mutate(Percentage = (n / sum(n)) * 100) %>%
ungroup() %>%
# Convert responses to factors to lock the scale order 1 to 7 (skipping 4)
mutate(Response = factor(Response, levels = c(1:3, 5:7))) %>%
# Assign absolute directional plot values (Negative vs Positive)
mutate(Plot_Value = case_when(
Response %in% 1:3 ~ -Percentage,
Response %in% 5:7 ~ Percentage
))
View(final_plot_data)
# 2. Generate the Diverging Stacked Bar Chart without Neutral 4s
ggplot(final_plot_data, aes(x = Question, y = Plot_Value, fill = Response)) +
geom_col(width = 0.65) +
geom_hline(yintercept = 0, color = "black", linewidth = 0.6) + # Perfect central split line
scale_y_continuous(
limits = c(-100, 100),
breaks = seq(-100, 100, by = 25),
labels = function(x) paste0(abs(x), "%") # Keeps labels looking like absolute positive percentages
) +
scale_fill_manual(
values = c(
"1" = "#b2182b", "2" = "#d6604d", "3" = "#f4a582", # Negative spectrum (Reds)
"5" = "#92c5de", "6" = "#4393c3", "7" = "#2166ac"  # Positive spectrum (Blues)
)
) +
coord_flip() +
labs(
x = NULL,
y = "Percentage of Non-Neutral Responses",
fill = "Scale"
) +
theme_minimal() +
theme(
panel.grid.major.y = element_blank(),
legend.position = "bottom"
)
# 1. Reshape, filter out 4s, and capture both total counts and percentages
final_plot_data <- dat %>%
select(famhelp, famsup, famtalk, famdec) %>%
pivot_longer(cols = everything(), names_to = "Question", values_to = "Response") %>%
filter(!is.na(Response) & Response != 4) %>%
count(Question, Response) %>%
group_by(Question) %>%
mutate(Percentage = (n / sum(n)) * 100) %>%
ungroup() %>%
mutate(Response = factor(Response, levels = c(1:3, 5:7))) %>%
mutate(Plot_Value = case_when(
Response %in% 1:3 ~ -Percentage,
Response %in% 5:7 ~ Percentage
)) %>%
# Create a clean text label showing both n and % (e.g., "45 (12%)")
mutate(Label_Text = paste0(n, " (", round(Percentage, 0), "%)"))
# 2. Generate the plot with text overlays
ggplot(final_plot_data, aes(x = Question, y = Plot_Value, fill = Response)) +
geom_col(width = 0.65) +
# Add the labels right inside the stacked columns
geom_text(
# If the block is too small (e.g., < 4%), hide the text to prevent messy overlaps
aes(label = ifelse(Percentage < 4, "", Label_Text)),
position = position_stack(vjust = 0.5), # Centers the text right inside its colored box
color = "white",
size = 3,
fontface = "bold"
) +
geom_hline(yintercept = 0, color = "black", linewidth = 0.6) +
scale_y_continuous(
limits = c(-100, 100),
breaks = seq(-100, 100, by = 25),
labels = function(x) paste0(abs(x), "%")
) +
scale_fill_manual(
values = c(
"1" = "#b2182b", "2" = "#d6604d", "3" = "#f4a582",
"5" = "#92c5de", "6" = "#4393c3", "7" = "#2166ac"
)
) +
coord_flip() +
labs(
x = NULL,
y = "Percentage of Non-Neutral Responses",
fill = "Scale"
) +
theme_minimal() +
theme(
panel.grid.major.y = element_blank(),
legend.position = "bottom"
)
