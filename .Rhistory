#install.packages("tidycorels")
require(corels)
require(tidycorels)
#install.packages("corels")
install.packages("tidycorels")
library(corels)
set.seed(42)
n <- 100
features <- data.frame(
FeatureA = sample(c(0, 1), n, replace = TRUE),
FeatureB = sample(c(0, 1), n, replace = TRUE),
FeatureC = sample(c(0, 1), n, replace = TRUE)
)
features
# Target variable (0 or 1)
labels <- sample(c(0, 1), n, replace = TRUE)
?tempfile
# 2. Write data to temporary files (CORELS core function requires text files)
rules_file <- tempfile(fileext = ".out")
labels_file <- tempfile(fileext = ".label")
# Format: Space-separated, first column is sample name, followed by features
write.table(cbind(paste0("sample_", 1:n), features),
file = rules_file, row.names = FALSE, col.names = TRUE, quote = FALSE)
write.table(labels, file = labels_file, row.names = FALSE, col.names = FALSE)
getwd()
# 3. Execute CORELS
# Arguments mimic the C++ command line options:
# -c: scheduling policy (e.g., "1" for curiosity, "2" for bfs)
# -r: regularization parameter balancing length vs accuracy (default 0.01)
output_rules <- corels(
rules_file = rules_file,
labels_file = labels_file,
log_dir = tempdir(),
regularization = 0.01,
verbosity = "rulelist",
policy = "curiosity"
)
output_rules <- corels(
rules_file = rules_file,
labels_file = labels_file,
log_dir = tempdir(),
regularization = 0.01,
verbosity = "rulelist",
policy = "curiosity"
)
# 4. View your optimal rule list
cat(output_rules)
?corels
output_rules <- corels(
rules_file = rules_file,
labels_file = labels_file,
log_dir = tempdir(),
meta_file = "",              # Required placeholder if not using minor bounds
regularization = 0.01,       # Accuracy penalty per rule
verbosity_policy = "rulelist",
run_curiosity = TRUE,        # Replaces policy="curiosity"
curiosity_policy = 2L        # 2L represents a standard curiosity policy search
)
output_rules <- corels(
rules_file = rules_file,
labels_file = labels_file,
log_dir = tempdir(),
meta_file = "",              # Required placeholder if not using minor bounds
regularization = 0.01,       # Accuracy penalty per rule
verbosity_policy = "rulelist",
run_curiosity = TRUE,        # Replaces policy="curiosity"
curiosity_policy = 2L        # 2L represents a standard curiosity policy search
)
output_rules <- corels(
rules_file = rules_file,
labels_file = labels_file,
log_dir = tempdir(),
meta_file = "",              # Required placeholder if not using minor bounds
regularization = 0.01,       # Accuracy penalty per rule
verbosity_policy = "loud",
run_curiosity = TRUE,        # Replaces policy="curiosity"
curiosity_policy = 2L        # 2L represents a standard curiosity policy search
)
output_rules <- corels(
rules_file = rules_file,
labels_file = labels_file,
log_dir = tempdir(),
meta_file = "",              # Required placeholder if not using minor bounds
regularization = 0.01,       # Accuracy penalty per rule
verbosity_policy = "rulelist",
run_curiosity = TRUE,        # Replaces policy="curiosity"
curiosity_policy = 2L        # 2L represents a standard curiosity policy search
)
output_rules <- corels(
rules_file = rules_file,
labels_file = labels_file,
log_dir = tempdir(),
meta_file = "",              # Required placeholder if not using minor bounds
regularization = 0.01,       # Accuracy penalty per rule
