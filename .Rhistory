sv_importance(tree_sv$.pred_Yes, kind = "beeswarm") + theme_minimal() #bee
str(hbsc_cmp$gender)
sv_waterfall(tree_sv$.pred_Yes, row_id = 5) + theme_minimal()
# pred Y and N examples
