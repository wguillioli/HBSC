tree1_spec <-
decision_tree(
cost_complexity = tune(),
tree_depth = tune(),
min_n = tune()
) |>
set_engine("rpart") |>
set_mode("classification")
tree1_grid <- grid_regular(cost_complexity(),
tree_depth(),
min_n(range = c(2,15)), #15 predictors on train
levels = 10)
dim(tree1_grid) #1000x3
