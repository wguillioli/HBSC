resamples = tree_folds,
grid = tree_grid
)
(Sys.time() - Start)
tree_res
tree_res
# see performance metrics of fitted trees
tree_res |> collect_metrics()
tree_res |> collect_metrics() |>
filter(.metric == "roc_auc")
tree_res |> collect_metrics() |>
filter(.metric == "roc_auc") %>%
boxplot()
tree_res |> collect_metrics() |>
filter(.metric == "roc_auc") %>%
table()
tree_res |> collect_metrics() |>
filter(.metric == "roc_auc")
