#redoing the good old way to confirm what glmnet tidymodels did
lr1 <- glm(mentalissue ~ .
-IOTF4
-IRRELFAS
-lifesat
-seqno_int
-IRFAS, #not sign
data = hbsc_se_train,
family = binomial)
