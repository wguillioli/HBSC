tree1_spec,
mentalissue ~ .,
resamples = folds,
grid = tree1_grid,
metrics = metric_set(bal_accuracy, roc_auc),
control = control_grid(verbose = TRUE) # Shows progress bars in the console
)
stopCluster(my_cluster)
registerDoSEQ()
print(Sys.time() - start)
