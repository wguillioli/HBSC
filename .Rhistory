step_dummy(all_nominal_predictors(), one_hot = TRUE)
# 2. Prep and bake (apply) the recipe to get the 0/1 dataframe
se_train_dummies <- prep(recipe_spec) %>% bake(new_data = NULL)
View(se_train_dummies)
