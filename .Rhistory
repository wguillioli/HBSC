custom_match = c(
"England"  = "Northern Europe",
"Scotland" = "Northern Europe",
"Wales"    = "Northern Europe"
)
),
# 1. First, establish the base UN Subregions
base_subregion = countrycode(
sourcevar = country,
origin = "country.name",
destination = "un.regionsub.name",
custom_match = c(
"England"  = "Northern Europe",
"Scotland" = "Northern Europe",
"Wales"    = "Northern Europe"
)
),
# 2. Refine into your exact Custom European Groups
euro_group = case_match(
country,
# Group A: Pure Nordic Group
"Denmark" | "Finland" | "Iceland" | "Norway" | "Sweden" | "Greenland" ~ "Nordic Europe",
# Group B: Move remaining Northern Europe to Western/British group
"England" | "Scotland" | "Wales" | "Ireland" ~ "Western Europe",
# Group C: Reassign Baltics if desired (UN calls them Northern, many prefer East)
"Estonia" | "Latvia" | "Lithuania" ~ "Eastern Europe",
# Default: Keep the remaining UN groupings (Western Europe, Eastern Europe, Southern Europe)
.default = base_subregion
)
)
