(train_metrics <- trained_model |>
augment(new_data = training(hbsc_se_split)) |>
my_metrics(truth = mentalissue,
estimate = .pred_class,
.pred_No)
)
# combine metrics for train/test
lr_metrics <- (train_metrics %>%
select(.metric, .estimate) %>%
mutate(set = "train")
) %>% bind_rows(
(test_metrics %>%
select(.metric, .estimate) %>%
mutate(set = "test")
)
)
