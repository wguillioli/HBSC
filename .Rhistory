sv_importance(tree_sv$.pred_Yes, kind = "beeswarm") + theme_minimal() #bee
# ---------------------------------------------------
# project setup
# ---------------------------------------------------
rm(list = ls())
require(tidyverse)
require(tidymodels)
require(stringr)
require(kableExtra)
library(scales)
library(corrplot)
library(psych)
require(rsample)
require(countrycode)
require(naniar) #na vis
library(janitor) #cool new plots
require(rpart.plot)
library(kernelshap)
library(shapviz)
library(vip) #needeD?
library(ggridges)
library(tinytable)
library(coefplot)
prj_fldr <- "C:/MisLocalFiles/Github/HBSC/"
setwd(prj_fldr)
options(scipen = 999)
img_file <- paste0(prj_fldr, "/Rimages/hbsc_wkspace_20261011.RData")
load(file = img_file)
library(tidymodels)
library(ranger)
library(themis)     # <--- Required for step_downsample()
library(doParallel)
levels(hbsc_se$mentalissue)
data_split <- initial_split(hbsc_se, prop = 0.8, strata = mentalissue)
train_data <- training(data_split)
test_data  <- testing(data_split)
# Folds must be stratified to preserve minority classes in each slice
folds <- vfold_cv(train_data, v = 10, strata = mentalissue)
# ------------------------------------------------------------------------
# 2. MODEL SPECIFICATION
# ------------------------------------------------------------------------
rf_spec <- rand_forest(
mtry  = tune(),
trees = tune(),
min_n = tune()
) %>%
set_mode("classification") %>%
set_engine("ranger", importance = "impurity")
rf_recipe <- recipe(mentalissue ~ ., data = train_data)
rf_workflow <- workflow() %>%
add_recipe(rf_recipe) %>%
add_model(rf_spec)
# ------------------------------------------------------------------------
# 3. DEFINE CUSTOM PARAMETER RANGES & GRID
# ------------------------------------------------------------------------
classification_metrics <- metric_set(accuracy, roc_auc, bal_accuracy)
rf_params <- extract_parameter_set_dials(rf_spec) %>%
finalize(train_data) %>%
update(trees = trees(range = c(100, 1000)))
rf_grid <- grid_latin_hypercube(rf_params, size = 20)
rf_grid
# ------------------------------------------------------------------------
# 4. EXECUTE PARALLEL TUNING
# ------------------------------------------------------------------------
cl <- makePSOCKcluster(parallel::detectCores() - 1)
registerDoParallel(cl)
rf_grid <- grid_latin_hypercube(rf_params, size = 5)
rf_grid
# ------------------------------------------------------------------------
# 4. EXECUTE PARALLEL TUNING
# ------------------------------------------------------------------------
cl <- makePSOCKcluster(parallel::detectCores() - 1)
registerDoParallel(cl)
system.time(
tuning_results <- tune_grid(
rf_workflow,
resamples = folds,
grid = rf_grid,
metrics = classification_metrics
)
)
stopCluster(cl)
registerDoSEQ()
1000/60
# ------------------------------------------------------------------------
# 5. SELECT BEST MODEL & FINAL COUPLING
# ------------------------------------------------------------------------
# When data is imbalanced, always use bal_accuracy or roc_auc to select the winner!
best_hyperparameters <- select_best(tuning_results, metric = "roc_aud") #bal_accuracy
# ------------------------------------------------------------------------
# 5. SELECT BEST MODEL & FINAL COUPLING
# ------------------------------------------------------------------------
# When data is imbalanced, always use bal_accuracy or roc_auc to select the winner!
best_hyperparameters <- select_best(tuning_results, metric = "roc_auc") #bal_accuracy
print("Winning Configuration:")
print(best_hyperparameters)
final_workflow <- finalize_workflow(rf_workflow, best_hyperparameters)
final_model_fit <- fit(final_workflow, data = train_data)
# ------------------------------------------------------------------------
# 6. EVALUATE TRAIN VS TEST SETS
# ------------------------------------------------------------------------
train_predictions <- augment(final_model_fit, new_data = train_data)
test_predictions  <- augment(final_model_fit, new_data = test_data)
print("--- TRAINING SET METRICS ---")
train_predictions %>% classification_metrics(truth = Species, estimate = .pred_class, contains(".pred_"))
train_predictions %>%
classification_metrics(truth = mentalissue, estimate = .pred_class, contains(".pred_"))
# ------------------------------------------------------------------------
# 6. EVALUATE TRAIN VS TEST SETS
# ------------------------------------------------------------------------
train_predictions <- augment(final_model_fit, new_data = train_data)
train_predictions
train_predictions %>%
classification_metrics(truth = mentalissue, estimate = .pred_class, ".pred_Yes")
train_predictions %>%
classification_metrics(truth = mentalissue, estimate = .pred_class, ".pred_No")
test_predictions %>%
classification_metrics(truth = mentalissue, estimate = .pred_class, contains(".pred_Yes"))
test_predictions %>%
classification_metrics(truth = mentalissue, estimate = .pred_class, contains(".pred_No"))
train_predictions %>%
classification_metrics(truth = mentalissue, estimate = .pred_class, ".pred_No")
test_predictions %>%
classification_metrics(truth = mentalissue, estimate = .pred_class, contains(".pred_No"))
img_file <- paste0(prj_fldr, "/Rimages/hbsc_wkspace_20261012.RData")
#load(file = img_file)
save.image(file = img_file)
