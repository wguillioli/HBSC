prj_fldr <- "C:/MisLocalFiles/Github/HBSC/"
setwd(prj_fldr)
options(scipen = 999)
require(tidyverse)
require(tidymodels)
require(stringr)
require(kableExtra)
library(scales)
library(corrplot)
library(psych)
require(rsample)
require(countrycode)
require(naniar) #na vis
library(janitor) #cool new plots
require(rpart.plot)
library(kernelshap)
library(shapviz)
library(vip) #needeD?
library(ggridges)
library(tinytable)
library(coefplot)
library(doParallel)
img_file <- paste0(prj_fldr, "/Rimages/hbsc_wkspace_20261022.RData")
load(file = img_file)
## RF vanilla --------------------
rf_spec <- rand_forest() |>
set_engine("ranger") |>
set_mode("classification")
rf_fit1_vanilla <- rf_spec |>
fit(mentalissue ~ ., data = train)
eval_mdl(rf_fit1_vanilla)
eval_test(rf_fit1_vanilla)
rf_spec <- rand_forest(
mtry = tune(),
min_n = tune(),
trees = tune()
) |>
set_engine("ranger") |>
set_mode("classification")
rf_recipe <- recipe(mentalissue ~ ., data = train)
rf_wflow <- workflow() |>
add_recipe(rf_recipe) |>
add_model(rf_spec)
rf_params <- extract_parameter_set_dials(rf_wflow) |>
finalize(train)
rf_grid <- grid_regular(rf_params, levels = 1)
dim(rf_grid)
cl <- makePSOCKcluster(5)
registerDoParallel(cl)
set.seed(67)
system.time(
rf1_res <- tune_grid(
rf_wflow,
resamples = folds,
grid = rf_grid,
metrics = metric_set(bal_accuracy, accuracy, roc_auc),
control = control_grid(verbose = TRUE) # Shows progress bars in the console
)
)
stopCluster(cl)
registerDoSEQ
registerDoSEQ()
autoplot(rf1_res)
rf_grid <- grid_regular(rf_params, levels = 2)
dim(rf_grid)
cl <- makePSOCKcluster(5)
registerDoParallel(cl)
set.seed(67)
system.time(
rf1_res <- tune_grid(
rf_wflow,
resamples = folds,
grid = rf_grid,
metrics = metric_set(bal_accuracy, accuracy, roc_auc),
control = control_grid(verbose = TRUE) # Shows progress bars in the console
)
)
autoplot(rf1_res)
# finalize wkflow to get final fit
final_rf_wflow <- finalize_workflow(
rf_wflow,
select_best(rf1_res, metric = "roc_auc"))
rf_fit1_tuned <- fit(final_rf_wflow, data = train)
eval_mdl(rf_fit1_tuned)
eval_test(rf_fit1_tuned)
## RF tuned -------------------
